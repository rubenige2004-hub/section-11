      // Tag outbound links for Umami event tracking. Runs once per page load.
      (function () {
        function tagOutboundLinks() {
          document.querySelectorAll('a').forEach(a => {
            if (a.host && a.host !== window.location.host && !a.getAttribute('data-umami-event')) {
              a.setAttribute('data-umami-event', 'outbound-link-click');
              a.setAttribute('data-umami-event-url', a.href);
            }
          });
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', tagOutboundLinks);
        } else {
          tagOutboundLinks();
        }
      })();
